FROM python:3.11-slim-bookworm

ARG APP_UID=10001
ARG APP_GID=10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp \
    PYTHONPATH=/app/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${APP_GID}" isalaocr \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --no-create-home --shell /usr/sbin/nologin isalaocr \
    && python -m pip install --no-cache-dir "Flask>=3.1,<4" "waitress>=3,<4" "PyYAML>=6,<7" "Pillow>=10,<13" "pydicom>=3,<4" "numpy>=1.26,<3" "opencv-python-headless>=4.10,<5"

WORKDIR /app

# The labeling UI deliberately does not install PaddleOCR or PaddlePaddle. It
# includes only the small Tesseract binary used for on-demand table-header hit
# matching; table inference remains in the training container.
# Copy these packages as directories instead of maintaining a fragile list of
# individual modules: adding a lightweight Python module must never produce an
# image that builds successfully but crashes at import time.
COPY application/src/isala_ocr/__init__.py /app/src/isala_ocr/__init__.py
COPY application/src/isala_ocr/config.py /app/src/isala_ocr/config.py
COPY application/src/isala_ocr/models.py /app/src/isala_ocr/models.py
COPY application/src/isala_ocr/geometry.py /app/src/isala_ocr/geometry.py
COPY application/src/isala_ocr/image_io.py /app/src/isala_ocr/image_io.py
COPY application/src/isala_ocr/dicom.py /app/src/isala_ocr/dicom.py
COPY application/src/isala_ocr/study_info.py /app/src/isala_ocr/study_info.py
COPY application/src/isala_ocr/application_processing /app/src/isala_ocr/application_processing
COPY application/src/isala_ocr/ocr /app/src/isala_ocr/ocr
COPY application/src/isala_ocr/training /app/src/isala_ocr/training

# Catch packaging/import regressions during docker build rather than after the
# container has already been created and the WebUI healthcheck starts failing.
RUN python -c "import isala_ocr.application_processing; from isala_ocr.training.webui import create_web_app; assert callable(create_web_app)"

RUN mkdir -p /training/workspace /tmp \
    && chown -R "${APP_UID}:${APP_GID}" /training /tmp

USER ${APP_UID}:${APP_GID}

ENTRYPOINT ["python", "-m", "isala_ocr.training.webui_server"]
CMD ["--workspace", "/training/workspace", "--host", "0.0.0.0", "--port", "8088"]
