# syntax=docker/dockerfile:1.7
# Lightweight IsalaOCR inference layer on top of the already prepared
# PaddleDetection CUDA image.  The expensive CUDA/Paddle layers are therefore
# reused; this image only adds the application code and DICOM/PP-Structure
# runtime helpers.  Do not install paddlepaddle here: the base image contains
# the CUDA build and replacing it with the CPU wheel would silently disable GPU.
ARG BASE_IMAGE=isalaocr-training-gpu-detection:3.8.5
FROM ${BASE_IMAGE}

USER root

# PaddleOCR/PaddleX imports pandas during startup. Keep NumPy on the 1.x ABI and
# install a matching pandas wheel explicitly; otherwise a transitive dependency
# can upgrade NumPy underneath an older pandas binary and fail with
# "numpy.dtype size changed" before PP-StructureV3 even reaches the GPU.
RUN --mount=type=cache,id=isalaocr-table-inference-pip-cache,target=/root/.cache/pip,sharing=locked \
    python3 -m pip install --upgrade \
      "numpy==1.26.4" \
      "pandas>=2.2,<2.3" \
      "paddleocr[doc-parser]==3.7.0" \
      "pydicom>=3.0,<4" \
      "PyYAML>=6,<7" \
      "rapidfuzz>=3,<4" \
      "pylibjpeg>=2,<3" \
      "pylibjpeg-libjpeg>=2,<3" \
      "pylibjpeg-openjpeg>=2,<3"

# Docker build does not have access to libcuda.so.1, so CUDA/Paddle imports are
# deliberately deferred to a runtime probe. This build-time check still catches
# the NumPy/pandas C-ABI failure deterministically without touching CUDA.
RUN python3 - <<'PYABI'
import importlib.metadata as metadata
import numpy
import pandas

assert numpy.__version__ == "1.26.4", numpy.__version__
print("NumPy/pandas ABI OK:", numpy.__version__, pandas.__version__)
print("PaddleOCR distribution:", metadata.version("paddleocr"))
print("PaddleX distribution:", metadata.version("paddlex"))
PYABI

COPY application/src /app/src
COPY application/config /app/config

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    PADDLE_PDX_CACHE_HOME=/models/paddlex \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

USER 10001:10001
WORKDIR /app
ENTRYPOINT ["python3", "-m", "isala_ocr"]
CMD ["--help"]
